# Copy to .env (or export in your shell). All values are optional.
PORT=3000

# Gemini Vision for real OCR of uploaded photos. Without it the app runs in strict fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=9000

# Platform PromptPay ID (phone / 13-digit tax ID). Default is a non-routable demo ID.
PROMPTPAY_ID=0000000000

# Where the SQLite file lives (default ./data)
DATA_DIR=./data

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=

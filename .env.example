# Copy to .env (or export in your shell). All values are optional.
PORT=3000

# Gemini Vision for real OCR of uploaded photos. Without it the app runs in strict fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=9000

# Single Demo PromptPay ID for all merchants & platform in demo mode (put your own team phone number here if testing real scans).
# If left empty, the system will NOT generate a payable QR code and will show "QR ตัวอย่าง ห้ามโอนเงิน" instead.
DEMO_PROMPTPAY_ID=
PROMPTPAY_ID=

# Where the SQLite file lives (default ./data)
DATA_DIR=./data

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=
